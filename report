];

// ── BUILD PEOPLE TABLE ─────────────────────────────────────────────────
const tbody = document.getElementById('people-tbody');
people.forEach(p => {
  const tr = document.createElement('tr');
  let html = `<td><span class="area-cell">
    <span style="width:28px;height:28px;border-radius:50%;background:var(--dark-green);display:inline-flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:var(--green);margin-right:8px;flex-shrink:0;">${p.initials}</span>
    <span class="area-name">${p.name}</span></span></td>`;
  AREAS.forEach(a => {
    const v = p.pct[a];
    const isPeak = (a === 'Conteúdo' && v > 60) || (a === 'Sales' && v > 50) || (a === 'Comunicação Interna' && v > 20);
    html += `<td${isPeak ? ' class="peak"' : ''}>
      <div class="cell-bar">
        <span class="cell-pct">${v.toFixed(1)}%</span>
        <div class="cell-mini" style="background:${COLORS[a]};width:${Math.max(v/100*48,2).toFixed(1)}px;"></div>
      </div></td>`;
  });
  html += `<td style="font-weight:500;">${p.total.toLocaleString('pt-BR')}</td>`;
  tr.innerHTML = html;
  tbody.appendChild(tr);
});

// ── BUILD PEOPLE CARDS ─────────────────────────────────────────────────
const cards = document.getElementById('people-cards');
people.forEach(p => {
  const sorted = [...AREAS].sort((a,b) => p.pct[b] - p.pct[a]);
  const noteMap = {
    'Alejandra Rios':     '205 tasks envolvidas',
    'Dani Torres':        '435 tasks envolvidas',
    'Diogo Sarilio':      '372 tasks envolvidas',
    'Gabriel Gomes':      '1.096 tasks · maior volume do time',
    'Mateo Soto Agudelo': '138 tasks envolvidas',
    'Sofia Morris':       '510 tasks envolvidas',
  };
  let bars = sorted.map(a => `
    <div class="pbar-row">
      <span class="pbar-label"><span class="pbar-dot" style="background:${COLORS[a]};"></span>${a}</span>
      <div class="pbar-track"><div class="pbar-fill" style="width:${p.pct[a]}%;background:${COLORS[a]};"></div></div>
      <span class="pbar-pct">${p.pct[a].toFixed(1)}%</span>
    </div>`).join('');
  cards.innerHTML += `
    <div class="person-card">
      <div class="person-header">
        <div class="person-avatar">${p.initials}</div>
        <div>
          <div class="person-name">${p.name}</div>
          <div class="person-total">${noteMap[p.name]}</div>
        </div>
      </div>
      <div class="person-bars">${bars}</div>
    </div>`;
});

