    scales: {
      y: { beginAtZero:true, max:80, ticks:{ callback:v=>v+'%', font:{family:'Roboto',size:11}, color:'#6b756e' }, grid:{ color:'rgba(107,117,110,0.12)' }, border:{ display:false } },
      x: { ticks:{ font:{family:'Roboto',size:12,weight:'500'}, color:'#1a231f' }, grid:{ display:false }, border:{ display:false } }
    }
  }
});
