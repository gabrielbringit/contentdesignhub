      { label:'Sales',               data:[33.9,23.8,45.6,29.3,8.3],  borderColor:'#1D9E75', backgroundColor:'transparent',           fill:false, tension:.35, pointRadius:5, pointHoverRadius:8, pointBackgroundColor:'#1D9E75', borderWidth:2.5 },
      { label:'Comunicação Interna', data:[24.5,27.8,6.5,3.4,12.4],   borderColor:'#C8900A', backgroundColor:'transparent',           fill:false, tension:.35, pointRadius:5, pointHoverRadius:8, pointBackgroundColor:'#C8900A', borderWidth:2.5 },
      { label:'Branding',            data:[13.6,14.8,2.3,3.0,1.2],    borderColor:'#C44A1A', backgroundColor:'transparent',           fill:false, tension:.35, pointRadius:5, pointHoverRadius:8, pointBackgroundColor:'#C44A1A', borderWidth:2 },
      { label:'Produto',             data:[4.5,14.8,5.3,5.2,5.3],     borderColor:'#6B55CC', backgroundColor:'transparent',           fill:false, tension:.35, pointRadius:5, pointHoverRadius:8, pointBackgroundColor:'#6B55CC', borderWidth:2, borderDash:[5,3] },
    ]
  },
  options: {
    responsive:true, maintainAspectRatio:false,
    plugins: {
      legend: { display:false },
      tooltip: {
        backgroundColor:'#1a231f', titleColor:'#7dbf41', bodyColor:'#fff', padding:12, cornerRadius:4,
        callbacks: { label: ctx => '  ' + ctx.dataset.label + ': ' + ctx.parsed.y.toFixed(1) + '%' }
